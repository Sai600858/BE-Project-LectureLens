  "node_edge_seg_01" -> "node_edge_vis_01" [label="corresponds_to", style="solid", color="#333333"];
  "node_edge_seg_02" -> "node_edge_vis_02" [label="corresponds_to", style="solid", color="#333333"];
  "concept_now" -> "node_edge_vis_02" [label="explains", style="solid", color="#333333"];
  "node_edge_seg_03" -> "node_edge_vis_01_repeat" [label="corresponds_to", style="solid", color="#333333"];
  "concept_states_nx_to_the_n_minus_1" -> "node_edge_vis_01_repeat" [label="explains", style="solid", color="#333333"];
