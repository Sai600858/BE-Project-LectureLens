    {
      "node_id": "node_bio_seg_02",
      "label": "The primary goal of excretion in human physiology ...",
      "node_type": "LectureSegment",
      "subject": "biology",
      "provenance_segment_ids": [
        "bio_seg_02"
      ],
      "provenance_visual_ids": [],
      "timestamps": [
        28.0,
        48.0
      ],
      "attributes": {
        "speaker": "instructor_sumit",
        "text": "The primary goal of excretion in human physiology is osmoregulation and maintaining a stable constant internal chemical composition known as homeostasis."
      }
    },
    {
      "node_id": "node_bio_seg_03",
      "label": "Looking at the types of excretion based on nitroge...",
      "node_type": "LectureSegment",
      "subject": "biology",
      "provenance_segment_ids": [
        "bio_seg_03"
      ],
      "provenance_visual_ids": [],
      "timestamps": [
        52.0,
        85.0
      ],
      "attributes": {
        "speaker": "instructor_sumit",
        "text": "Looking at the types of excretion based on nitrogenous waste, animals eliminate waste differently based on water availability: ammonotelism with ammonia which is highly toxic and needs the most water, ureotelism with urea which is moderately toxic, and uricotelism with uric acid which is least toxic and needs minimal water."
      }
    },
