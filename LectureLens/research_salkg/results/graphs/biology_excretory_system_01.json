      "attributes": {
        "visual_type": "diagram",
        "extracted_text": "Types of Excretion based on Nitrogenous Waste. Classification of organisms by primary nitrogenous waste product and water requirement: Ammonotelism (ammonia, highly toxic, needs most water), Ureotelism (urea, moderately toxic, needs moderate water), Uricotelism (uric acid, least toxic, needs minimal water). Homeostasis and Osmoregulation.",
        "formula_latex": null,
        "code_content": null,
        "description": "Classification chart of nitrogenous waste types and osmoregulation"
      }
    },
