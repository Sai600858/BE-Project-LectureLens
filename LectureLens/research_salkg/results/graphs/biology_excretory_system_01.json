    {
      "node_id": "node_bio_seg_01",
      "label": "Excretion is the biological process of expelling n...",
      "node_type": "LectureSegment",
      "subject": "biology",
      "provenance_segment_ids": [
        "bio_seg_01"
      ],
      "provenance_visual_ids": [],
