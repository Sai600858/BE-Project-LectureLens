    {
      "node_id": "node_math_seg_03",
      "label": "Let us state the formal theorem. If y equals f of ...",
      "node_type": "LectureSegment",
      "subject": "mathematics",
      "provenance_segment_ids": [
        "math_seg_03"
      ],
      "provenance_visual_ids": [],
      "timestamps": [
        58.0,
        95.0
      ],
      "attributes": {
        "speaker": "lecturer_1",
        "text": "Let us state the formal theorem. If y equals f of u and u equals g of x, then dy by dx equals dy by du times du by dx."
      }
    },
    {
      "node_id": "node_math_seg_04",
      "label": "From this theorem we derive the derivative of comp...",
      "node_type": "LectureSegment",
