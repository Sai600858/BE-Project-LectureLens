# Server Configuration
PORT=3001
NODE_ENV=development

# JWT Authentication Secret (Must be strong and kept private in production)
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_chars

# AI Service Credentials
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# STT & AI Service Ports
LLM_PORT=5000
AI_SERVICE_URL=http://localhost:8000

# CORS Allowed Origins (Comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:5173
